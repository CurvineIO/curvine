# Template rendered by bin/curvine-systemd.sh install; @...@ placeholders are
# replaced with the installation paths and the service account.

[Unit]
Description=Curvine master
Documentation=https://github.com/CurvineIO/curvine/tree/main/build/systemd
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@CURVINE_USER@
Group=@CURVINE_GROUP@
WorkingDirectory=@CURVINE_HOME@
ExecStart=@CURVINE_HOME@/bin/curvine-master.sh run
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=curvine-master

[Install]
WantedBy=multi-user.target
