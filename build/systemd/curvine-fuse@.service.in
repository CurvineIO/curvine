# Template rendered by bin/curvine-systemd.sh install; @...@ placeholders are
# replaced with the installation paths and the service account.
#
# One instance per mount point. The instance name is the escaped mount path:
#   systemctl enable --now "$(systemd-escape --path --template=curvine-fuse@.service /curvine-fuse)"
# Extra curvine-fuse options go into CURVINE_FUSE_OPTS through a drop-in
# (systemctl edit curvine-fuse@<instance>.service).

[Unit]
Description=Curvine FUSE mount at %f
Documentation=https://github.com/CurvineIO/curvine/tree/main/build/systemd
Wants=network-online.target
# Ordering only: start after the master and worker when they run on this host.
After=network-online.target curvine-master.service curvine-worker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@CURVINE_USER@
Group=@CURVINE_GROUP@
WorkingDirectory=@CURVINE_HOME@
Environment=CURVINE_FUSE_OPTS=
ExecStart=@CURVINE_HOME@/bin/curvine-fuse.sh run --mnt-path %f $CURVINE_FUSE_OPTS
# A crashed or killed curvine-fuse leaves a dead mount behind ("Transport
# endpoint is not connected"), which would make every restart attempt fail.
# Detach it after each stop; after a clean stop the path is already unmounted
# and the error is ignored.
ExecStopPost=-+/bin/umount -l %f
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=curvine-fuse

[Install]
WantedBy=multi-user.target
